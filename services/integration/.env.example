# Copy to .env next to this file and fill in. Never commit .env.
# Load it in Git Bash with:  set -a; . ./.env; set +a
AVELA_CORE_URL=https://avela.stei.fun
# Key with scope snapshots:write, created on the STB: docker compose exec core python -m app.keys create integration snapshots:write
AVELA_SNAPSHOT_KEY=
PUSH_INTERVAL_MINUTES=60
# Partner services. Leave a BASE_URL empty to serve the labelled fixture (isMock: true, D-35).
VERIQU_BASE_URL=
VERIQU_API_KEY=
FLOWGANIC_BASE_URL=
FLOWGANIC_API_KEY=
# Agreed FlowGanic area codes per pilot area, as JSON, e.g. {"pekanbaru": ["14.71.01.1001"], "palangka-raya": ["62.71.01.1001"]}
FLOWGANIC_AREA_CODES=
