# Copy to .env next to this file and fill in. Never commit .env.
# Load it in Git Bash with:  set -a; . ./.env; set +a
AVELA_CORE_URL=https://avela.stei.fun
# Key with scope snapshots:write, created on the STB: docker compose exec core python -m app.keys create integration snapshots:write
AVELA_SNAPSHOT_KEY=
PUSH_INTERVAL_MINUTES=60
